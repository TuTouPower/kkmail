{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run && npm run openapi:check",
    "openapi:gen": "openapi-typescript ../docs/openapi.json -o src/api/generated/schema.ts",
    "openapi:check": "openapi-typescript ../docs/openapi.json -o src/api/generated/schema.check.ts && node ./scripts/openapi-check.mjs && rm -f src/api/generated/schema.check.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}

# kkmail (mail-core) — copy to .env for docker-compose.mail-core.yml. No defaults: every value must be set by you.
# Full variable reference: mail_core/README.md

# PostgreSQL password for the bundled postgres service
POSTGRES_PASSWORD=

# Session signing key:  openssl rand -hex 32
MAIL_CORE_SECRET_KEY=

# Login: prefer a bcrypt hash; a plaintext password is hashed at startup
MAIL_CORE_LOGIN_PASSWORD_HASH=
# MAIL_CORE_LOGIN_PASSWORD=

# Optional Bearer API keys (comma-separated or a JSON list)
# MAIL_CORE_API_KEYS=

# Blob and credential encryption key, base64 of 32 bytes:
#   python3 -c 'import os,base64; print(base64.b64encode(os.urandom(32)).decode())'
MAIL_CORE_BLOB_KEY_V1=
# Backup key (base64 of 32 bytes); it must differ from the blob key
MAIL_CORE_BACKUP_KEY=

# =============================================================================
# Flask 基础配置
# =============================================================================

# 必须设置！生成随机串：
#   openssl rand -hex 32
#   # 或: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# 登录密码（必须自行设置强密码；无默认值）
# 首次启动后会哈希存储；已写入数据库后再改此变量不会覆盖当前密码。
# 忘记密码请用 scripts/reset_login_password.py
LOGIN_PASSWORD=

# =============================================================================
# 应用运行时
# =============================================================================
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production

# 全局日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL（默认 INFO）
# LOG_LEVEL=WARNING

# 数据库路径
DATABASE_PATH=data/outlook_accounts.db

# IMAP 超时（秒）
IMAP_TIMEOUT=45

# 邮件列表整体获取超时（秒），也可在系统设置中调整
MAIL_FETCH_OVERALL_TIMEOUT=120

# =============================================================================
# mail-core（可选；与 docker-compose.mail-core.yml 一起使用）
# =============================================================================
# MAIL_CORE_SECRET_KEY=   # 或复用 SECRET_KEY；签名 Cookie Session 必填
# MAIL_CORE_LOGIN_PASSWORD_HASH=   # bcrypt 哈希（推荐）
# MAIL_CORE_LOGIN_PASSWORD=        # 或明文口令（启动时哈希；勿提交真实值）
# MAIL_CORE_API_KEYS=              # 逗号分隔或 JSON 列表；Bearer 集成用
# MAIL_CORE_BLOB_KEY_V1=           # base64(32-byte)；python3 -c 'import os,base64; print(base64.b64encode(os.urandom(32)).decode())'
# MAIL_CORE_BACKUP_KEY=            # 必须与 blob key 不同
# POSTGRES_PASSWORD=               # mail-core Postgres

# =============================================================================
# 临时邮箱服务
# =============================================================================
GPTMAIL_BASE_URL=https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=gpt-test

DUCKMAIL_BASE_URL=https://api.duckmail.sbs
DUCKMAIL_API_KEY=

# =============================================================================
# OAuth2 配置（可选，不填使用默认值）
# =============================================================================
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_REDIRECT_URI=http://localhost:8080

# Docker socket 自更新已移除：请用镜像标签 / 发布流程手动升级，勿挂载 docker.sock。

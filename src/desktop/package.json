{
  "name": "kkmail-desktop",
  "version": "3.0.20",
  "description": "kkmail desktop shell \u2014 Electron hosts the React UI and the mail-core backend",
  "main": "main.js",
  "homepage": "https://github.com/TuTouPower/kkmail",
  "author": "TuTouPower <tutoupower@users.noreply.github.com>",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node paths.test.js && node hardening.test.js && node postgresManager.test.js && node startup.test.js && node logRotation.test.js && node packLinux.test.js",
    "test:packaged": "node scripts/packaged-smoke.js",
    "dist:linux:dir": "node scripts/pack-linux.js",
    "pack:linux": "node scripts/pack-linux.js",
    "pack:linux:with-pg": "node scripts/pack-linux.js"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tutoupower.kkmail",
    "productName": "kkmail",
    "directories": {
      "output": "release"
    },
    "files": [
      "icon.svg",
      "main.js",
      "package.json",
      "paths.js",
      "hardening.js",
      "logRotation.js",
      "postgresManager.js",
      "preload.js",
      "startup.js"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "resources",
        "to": "backend",
        "filter": [
          "kkmail-backend*"
        ]
      },
      {
        "from": "vendor/pgsql",
        "to": "pgsql",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/README.md",
        "to": "pgsql-README.md"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "kkmail.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "dir",
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "TuTouPower <tutoupower@users.noreply.github.com>"
    },
    "artifactName": "${productName}-${version}.${ext}"
  }
}

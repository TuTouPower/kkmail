# kkmail (mail-core) environment configuration template.
# Copy to .env for docker-compose.mail-core.yml or local deployment.
# Full variable reference: src/mail_core/README.md

# ==============================================================================
# 1. 核心凭据与密钥 (Required Credentials & Keys)
# ==============================================================================

# PostgreSQL password for the bundled postgres service
POSTGRES_PASSWORD=

# Session signing secret key: generate via `openssl rand -hex 32`
MAIL_CORE_SECRET_KEY=

# Blob and credential keyring v1 key, base64 of 32 bytes:
#   python3 -c 'import os,base64; print(base64.b64encode(os.urandom(32)).decode())'
MAIL_CORE_BLOB_KEY_V1=

# Backup encryption key (base64 of 32 bytes); must differ from the blob key:
MAIL_CORE_BACKUP_KEY=

# Initial login credential (prefer bcrypt hash; plaintext password is auto-hashed at startup)
MAIL_CORE_LOGIN_PASSWORD_HASH=
# MAIL_CORE_LOGIN_PASSWORD=

# ==============================================================================
# 2. 服务监听与网络代理 (Server, Network & Proxy)
# ==============================================================================

# Server bind host and port (defaults: 127.0.0.1 and 8000)
# MAIL_CORE_HOST=127.0.0.1
# MAIL_CORE_PORT=8000

# Optional data directory for bootstrap secrets/blobs
# MAIL_CORE_DATA_DIR=

# Proxy headers handling (requires MAIL_CORE_FORWARDED_ALLOW_IPS)
# MAIL_CORE_PROXY_HEADERS=0
# MAIL_CORE_FORWARDED_ALLOW_IPS=

# Externally reachable HTTPS origin for Microsoft Web OAuth callback
# MAIL_CORE_PUBLIC_ORIGIN=
# MAIL_CORE_ALLOW_LOOPBACK_OAUTH_ORIGIN=0

# Allow IMAP connections to loopback/private hosts (defaults off)
# MAIL_CORE_ALLOW_PRIVATE_HOSTS=0

# ==============================================================================
# 3. 数据库连接与连接池 (Database & Connection Pool)
# ==============================================================================

# PostgreSQL connection URL (e.g. postgresql+psycopg://user:pass@127.0.0.1:5432/dbname)
# MAIL_CORE_DATABASE_URL=

# SQLAlchemy connection pool settings (defaults: 10 / 10 / 30.0s / 1800s)
# MAIL_CORE_DB_POOL_SIZE=10
# MAIL_CORE_DB_MAX_OVERFLOW=10
# MAIL_CORE_DB_POOL_TIMEOUT=30.0
# MAIL_CORE_DB_POOL_RECYCLE=1800

# ==============================================================================
# 4. 邮件服务商连接槽位与并发 (Provider Connection Slots & Concurrency)
# ==============================================================================

# Total outbound provider connections across all processes (default: 8)
# MAIL_CORE_TOTAL_SLOTS=8

# Slot index from which background archive traffic may run (default: 2, reserving slots 0-1 for interactive)
# MAIL_CORE_BACKGROUND_START_SLOT=2

# Retry delay in seconds when provider connection capacity is saturated (default: 5.0)
# MAIL_CORE_CAPACITY_RETRY_SECONDS=5.0

# ==============================================================================
# 5. 邮件规格与归档限制 (Mail & Storage Specifications)
# ==============================================================================

# Maximum raw MIME bytes accepted before parse error rejection (default: 52428800 = 50MB)
# MAIL_CORE_MAX_MIME_BYTES=52428800

# Maximum single attachment bytes accepted before omission (default: 26214400 = 25MB)
# MAIL_CORE_MAX_ATTACHMENT_BYTES=26214400

# Routine batch size and recent days for routine background archiving (defaults: 20 / 30)
# MAIL_CORE_ARCHIVE_BATCH=20
# MAIL_CORE_ARCHIVE_RECENT_DAYS=30

# Optional soft and hard storage quota bytes
# MAIL_CORE_BLOB_SOFT_BYTES=
# MAIL_CORE_BLOB_HARD_BYTES=

# ==============================================================================
# 6. Worker 任务处理与定时巡检 (Worker & Periodic Scheduling)
# ==============================================================================

# Embedded in-process worker thread (1=enabled, 0=disabled; default: 1)
# MAIL_CORE_EMBEDDED_WORKER=1

# Worker ID (auto-generated worker-UUID when unset)
# MAIL_CORE_WORKER_ID=

# Worker local queue poll interval and max idle backoff seconds (defaults: 2.0 / 10.0)
# MAIL_CORE_WORKER_POLL_S=2.0
# MAIL_CORE_WORKER_MAX_IDLE_S=10.0

# Number of jobs claimed per tick (default: 5)
# MAIL_CORE_CLAIM_BATCH=5

# Stale job claim reclaim interval in seconds (default: 60.0)
# MAIL_CORE_RECLAIM_INTERVAL_S=60.0

# Background periodic inbox poll interval in seconds (default: 1200, i.e. 20 minutes)
# MAIL_CORE_INBOX_POLL_INTERVAL_S=1200

# Scheduler overdue inbox inspection tick interval in seconds (default: 60.0)
# MAIL_CORE_SCHEDULE_INTERVAL_S=60.0

# ==============================================================================
# 7. 安全、会话与速率限制 (Security, Sessions & Rate Limiting)
# ==============================================================================

# Web session cookie max age in seconds (default: 2592000 = 30 days)
# MAIL_CORE_SESSION_MAX_AGE=2592000

# Session cookie SameSite policy (lax / strict / none; default: lax)
# MAIL_CORE_COOKIE_SAMESITE=lax

# Failed login rate limit (defaults: 10 failures per 300.0 seconds)
# MAIL_CORE_LOGIN_MAX_FAILURES=10
# MAIL_CORE_LOGIN_WINDOW_S=300.0

# Maximum concurrent Server-Sent Events (SSE) connections (default: 128)
# MAIL_CORE_SSE_MAX_CONNECTIONS=128

# Root log level threshold (DEBUG / INFO / WARNING / ERROR; default: INFO)
# MAIL_CORE_LOG_LEVEL=INFO
